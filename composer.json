{
  "name": "flexphp/framework",
  "description": "FlexPHP — A lightweight, async-capable PHP framework following PSR standards",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/container": "^2.0",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "psr/event-dispatcher": "^1.0",
    "cycle/orm": "^2.7",
    "cycle/database": "^2.9",
    "cycle/annotated": "^4.0",
    "cycle/migrations": "^4.1",
    "cycle/schema-builder": "^2.8",
    "spiral/tokenizer": "^3.13",
    "vlucas/phpdotenv": "^5.6",
    "nikic/fast-route": "^1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FlexPHP\\": "src/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": ["flex"],
  "scripts": {
    "test": "phpunit"
  }
}

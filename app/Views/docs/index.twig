namespace App\Console\Commands;
use FlexPHP\Console\BaseCommand;

class EnvoyerNewsletterCommand extends BaseCommand
{
    public function getName(): string        { return 'newsletter:envoyer'; }
    public function getDescription(): string { return 'Envoie la newsletter'; }

    public function handle(): int
    {
        $limit = (int) $this->getOption('limit', 100);

        $this->info("Envoi (limit: {$limit})");

        try {
            $this->success('Newsletter envoyée.');
            return 0;
        } catch (\Throwable $e) {
            $this->error($e->getMessage());
            return 1;
        }
    }
}</code></pre>


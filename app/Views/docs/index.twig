{% extends 'layouts/main.twig' %}

{% block title %}{% if currentPage %}{{ pageTitle }} — {% endif %}Documentation — FlexPHP{% endblock %}

{% block head %}
<style>
.docs-wrapper { display:flex; gap:0; min-height:calc(100vh - 56px - 56px); margin:-2rem -1.25rem; }

.docs-sidebar {
    width:260px; flex-shrink:0; background:#1a1a2e;
    padding:1.75rem 0; position:sticky; top:56px;
    height:calc(100vh - 56px); overflow-y:auto;
}
.docs-sidebar h2 { color:#8892b0; font-size:.7rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:0 1.5rem .75rem; }
.docs-sidebar a  { display:block; padding:.45rem 1.5rem; color:#ccd6f6; text-decoration:none; font-size:.9rem; border-left:3px solid transparent; transition:background .15s,border-color .15s,color .15s; }
.docs-sidebar a:hover { background:rgba(233,69,96,.15); color:#e94560; border-left-color:#e94560; }
.docs-sidebar a.active { background:rgba(233,69,96,.2); color:#e94560; border-left-color:#e94560; font-weight:600; }

.docs-content { flex:1; padding:2.5rem 3rem; max-width:860px; min-width:0; }
.docs-content h1 { font-size:2rem; color:#1a1a2e; margin-bottom:1rem; padding-bottom:.5rem; border-bottom:2px solid #e94560; }
.docs-content h2 { font-size:1.45rem; color:#0f3460; margin:2.25rem 0 .75rem; }
.docs-content h3 { font-size:1.1rem; color:#333; margin:1.5rem 0 .5rem; }
.docs-content p  { margin-bottom:1rem; line-height:1.8; color:#444; }
.docs-content ul,.docs-content ol { margin:0 0 1rem 1.5rem; line-height:1.8; color:#444; }
.docs-content li { margin-bottom:.25rem; }
.docs-content a  { color:#e94560; text-decoration:none; }
.docs-content a:hover { text-decoration:underline; }

.docs-content code { background:#f0f0f0; border-radius:3px; padding:.1rem .4rem; font-size:.875em; font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace; color:#c0392b; }
.docs-content pre  { background:#1a1a2e; color:#ccd6f6; padding:1.5rem; border-radius:8px; overflow-x:auto; font-size:.875rem; line-height:1.7; margin:1rem 0 1.5rem; }
.docs-content pre code { background:none; color:inherit; padding:0; font-size:inherit; }

.callout { border-left:4px solid; padding:.9rem 1.25rem; border-radius:0 6px 6px 0; margin:1.25rem 0; font-size:.9rem; line-height:1.7; }
.callout-info    { border-color:#0f3460; background:#eef2ff; color:#0f3460; }
.callout-warning { border-color:#f39c12; background:#fffbea; color:#7d5000; }
.callout-tip     { border-color:#27ae60; background:#edfaf3; color:#1a6b3c; }

.docs-content table { width:100%; border-collapse:collapse; margin:1rem 0 1.5rem; font-size:.9rem; }
.docs-content th    { background:#1a1a2e; color:#ccd6f6; padding:.6rem 1rem; text-align:left; font-weight:600; }
.docs-content td    { border:1px solid #dee2e6; padding:.55rem 1rem; vertical-align:top; }
.docs-content tr:nth-child(even) td { background:#f8f9fa; }

.docs-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1rem; margin-top:1.5rem; }
.docs-grid a { display:block; background:#fff; border:1px solid #dee2e6; border-radius:8px; padding:1.25rem; text-decoration:none; color:#1a1a2e; transition:border-color .15s,box-shadow .15s; }
.docs-grid a:hover { border-color:#e94560; box-shadow:0 2px 8px rgba(233,69,96,.15); color:#e94560; }
.docs-grid a span { display:block; font-size:.8rem; color:#888; margin-top:.25rem; }

.docs-nav-bottom { display:flex; justify-content:space-between; margin-top:3rem; padding-top:1.5rem; border-top:1px solid #dee2e6; gap:1rem; }
.docs-nav-bottom a { display:inline-flex; align-items:center; gap:.4rem; padding:.6rem 1.2rem; background:#1a1a2e; color:#ccd6f6; text-decoration:none; border-radius:6px; font-size:.875rem; font-weight:600; transition:background .15s; }
.docs-nav-bottom a:hover { background:#e94560; color:#fff; }

@media(max-width:768px) {
    .docs-wrapper { flex-direction:column; margin:-2rem -1.25rem; }
    .docs-sidebar { width:100%; height:auto; position:static; display:flex; flex-wrap:wrap; padding:1rem; gap:.25rem; }
    .docs-sidebar h2 { width:100%; }
    .docs-sidebar a { border-left:none; border-bottom:2px solid transparent; padding:.3rem .75rem; }
    .docs-sidebar a.active { border-bottom-color:#e94560; border-left:none; }
    .docs-content { padding:1.75rem 1.25rem; }
}
</style>
{% endblock %}

{% block content %}
{% set pageKeys = pages|keys %}

<div class="docs-wrapper">

    {# ── Sidebar ── #}
    <aside class="docs-sidebar">
        <h2>Documentation</h2>
        {% for slug, label in pages %}
            <a href="/docs/{{ slug }}" class="{{ currentPage == slug ? 'active' : '' }}">{{ label }}</a>
        {% endfor %}
    </aside>

    {# ── Content ── #}
    <div class="docs-content">

        {# ================================================================ #}
        {# HOME                                                              #}
        {# ================================================================ #}
        {% if currentPage is null %}

        <h1>Documentation FlexPHP</h1>
        <p>Bienvenue dans la documentation officielle de <strong>FlexPHP</strong>. Choisissez un sujet dans le menu ou commencez par la prise en main.</p>

        <div class="callout callout-tip">
            <strong>Nouveau ici ?</strong> Commencez par <a href="/docs/getting-started">Prise en main</a> pour installer le framework et créer votre première page en moins de 5 minutes.
        </div>

        <h2>Parcourir la documentation</h2>
        <div class="docs-grid">
            {% for slug, label in pages %}
                <a href="/docs/{{ slug }}">{{ label }}<span>→</span></a>
            {% endfor %}
        </div>

        <h2>À propos</h2>
        <table>
            <tr><th>Composant</th><th>Détail</th></tr>
            <tr><td>Version</td><td>1.0.0</td></tr>
            <tr><td>PHP requis</td><td>8.1+</td></tr>
            <tr><td>Licence</td><td>MIT</td></tr>
            <tr><td>Templating</td><td>Twig 3.x</td></tr>
            <tr><td>ORM</td><td>Cycle ORM 2.x</td></tr>
            <tr><td>Routeur</td><td>nikic/fast-route</td></tr>
            <tr><td>PSR</td><td>3, 4, 7, 11, 12, 14, 15</td></tr>
        </table>

        {# ================================================================ #}
        {# GETTING STARTED                                                   #}
        {# ================================================================ #}
        {% elseif currentPage == 'getting-started' %}

        <h1>Prise en main</h1>

        <h2>Prérequis</h2>
        <ul>
            <li>PHP <strong>8.1</strong> ou supérieur</li>
            <li>Extensions : <code>pdo</code>, <code>pdo_mysql</code> (ou sqlite/pgsql), <code>json</code>, <code>mbstring</code></li>
            <li>Composer</li>
        </ul>

        <h2>Installation</h2>
        <pre><code>git clone &lt;url-du-repo&gt; mon-projet
cd mon-projet
composer install
cp .env.example .env</code></pre>
        <p>Éditez <code>.env</code> avec vos paramètres (base de données, URL, etc.).</p>

        <h2>Démarrer le serveur de développement</h2>
        <pre><code>php flex serve
# Serveur disponible sur http://localhost:8000</code></pre>

        <h2>Structure du projet</h2>
        <pre><code>mon-projet/
├── app/
│   ├── Controllers/      # Vos contrôleurs HTTP
│   ├── Models/           # Entités Cycle ORM
│   ├── Middleware/       # Middleware personnalisés
│   ├── Providers/        # Service providers
│   └── Views/            # Templates Twig (.twig)
├── config/               # Fichiers de configuration
├── database/
│   ├── migrations/       # Fichiers de migration
│   └── seeders/
├── public/
│   ├── index.php         # Point d'entrée HTTP
│   └── js/flex.js        # Bibliothèque async
├── routes/
│   ├── web.php           # Routes web
│   └── api.php           # Routes API
├── src/                  # Cœur du framework
├── storage/logs/         # Logs applicatifs
├── .env                  # Variables d'environnement
└── flex                  # CLI</code></pre>

        <h2>Votre première page</h2>
        <p><strong>1. Créez un contrôleur :</strong></p>
        <pre><code>php flex make:controller HelloController</code></pre>

        <p><strong>2. Éditez <code>app/Controllers/HelloController.php</code> :</strong></p>
        <pre><code>&lt;?php
declare(strict_types=1);
namespace App\Controllers;

use FlexPHP\Http\Request;
use FlexPHP\Http\Response;

class HelloController extends BaseController
{
    public function index(Request $request): Response
    {
        return $this->view('hello', ['name' => 'Monde']);
    }
}</code></pre>

        <p><strong>3. Créez la vue <code>app/Views/hello.twig</code> :</strong></p>
        <pre><code>{% verbatim %}{% extends 'layouts/main.twig' %}

{% block content %}
    &lt;h1>Bonjour, {{ name }} !&lt;/h1>
{% endblock %}{% endverbatim %}</code></pre>

        <p><strong>4. Ajoutez la route dans <code>routes/web.php</code> :</strong></p>
        <pre><code>$router->get('/hello', 'App\Controllers\HelloController@index', 'hello');</code></pre>

        <p>Ouvrez <code>http://localhost:8000/hello</code> — votre page s'affiche.</p>

        <div class="callout callout-info">
            <strong>Twig en production :</strong> mettez <code>APP_DEBUG=false</code> dans <code>.env</code> pour activer la mise en cache des templates compilés dans <code>storage/cache/views/</code>.
        </div>

        {# ================================================================ #}
        {# ROUTING                                                           #}
        {# ================================================================ #}
        {% elseif currentPage == 'routing' %}

        <h1>Routage</h1>
        <p>Les routes sont déclarées dans <code>routes/web.php</code>. La variable <code>$router</code> est disponible automatiquement.</p>

        <h2>Méthodes disponibles</h2>
        <pre><code>$router->get('/articles', [ArticleController::class, 'index']);
$router->post('/articles', [ArticleController::class, 'store']);
$router->put('/articles/{id}', [ArticleController::class, 'update']);
$router->patch('/articles/{id}', [ArticleController::class, 'patch']);
$router->delete('/articles/{id}', [ArticleController::class, 'destroy']);
$router->any('/webhook', [WebhookController::class, 'handle']);</code></pre>

        <h2>Closures</h2>
        <pre><code>$router->get('/ping', function (Request $request): Response {
    return Response::json(['status' => 'ok']);
});</code></pre>

        <h2>Paramètres d'URL</h2>
        <pre><code>// Paramètre simple
$router->get('/articles/{slug}', [ArticleController::class, 'show']);

// Avec contrainte regex
$router->get('/users/{id:\d+}', [UserController::class, 'show']);

// Plusieurs paramètres
$router->get('/blog/{year:\d{4}}/{slug}', [BlogController::class, 'show']);</code></pre>

        <p>Les paramètres sont injectés en arguments après <code>Request</code> :</p>
        <pre><code>public function show(Request $request, string $id): Response
{
    // $id = valeur capturée depuis l'URL
}</code></pre>

        <h2>Routes nommées & génération d'URL</h2>
        <pre><code>// 3e argument = nom de la route
$router->get('/users/{id:\d+}', [UserController::class, 'show'], 'users.show');

// Depuis un contrôleur
$url = $this->router->url('users.show', ['id' => 42]); // '/users/42'

// Depuis un template Twig
// {{ url('users.show', {id: 42}) }}</code></pre>

        <h2>Groupes</h2>
        <pre><code>$router->group('/admin', function (Router $r) {
    $r->get('/dashboard', [AdminController::class, 'dashboard']);
}, [AuthMiddleware::class]);

// Imbriqués
$router->group('/api', function (Router $r) {
    $r->group('/v1', function (Router $r) {
        $r->get('/articles', [ArticleController::class, 'index']);
    });
});</code></pre>

        {# ================================================================ #}
        {# CONTROLLERS                                                       #}
        {# ================================================================ #}
        {% elseif currentPage == 'controllers' %}

        <h1>Contrôleurs</h1>

        <h2>Créer un contrôleur</h2>
        <pre><code>php flex make:controller ArticleController
php flex make:controller ArticleController --resource</code></pre>

        <h2>Structure de base</h2>
        <pre><code>&lt;?php
declare(strict_types=1);
namespace App\Controllers;

use FlexPHP\Http\Request;
use FlexPHP\Http\Response;

class ArticleController extends BaseController
{
    public function index(Request $request): Response
    {
        return $this->view('articles/index', ['articles' => []]);
    }

    public function show(Request $request, string $id): Response
    {
        return $this->view('articles/show', ['id' => $id]);
    }

    public function store(Request $request): Response
    {
        $titre = $request->getInput('titre');
        return $this->redirect('/articles');
    }
}</code></pre>

        <h2>Méthodes héritées de BaseController</h2>
        <table>
            <tr><th>Méthode</th><th>Description</th></tr>
            <tr><td><code>$this->view($template, $data)</code></td><td>Rend un template Twig → Response HTML</td></tr>
            <tr><td><code>$this->json($data, $status)</code></td><td>Retourne une Response JSON</td></tr>
            <tr><td><code>$this->redirect($url, $status)</code></td><td>Retourne une Response de redirection</td></tr>
            <tr><td><code>$this->abort($status, $message)</code></td><td>Retourne une Response d'erreur</td></tr>
        </table>

        <h2>Injection de dépendances</h2>
        <pre><code>class ArticleController extends BaseController
{
    public function __construct(
        private ArticleRepository $articles,
        ViewEngine $view,
        Request $request,
    ) {
        parent::__construct($view, $request);
    }
}</code></pre>

        {# ================================================================ #}
        {# REQUESTS                                                          #}
        {# ================================================================ #}
        {% elseif currentPage == 'requests' %}

        <h1>Requêtes HTTP</h1>
        <p>La classe <code>FlexPHP\Http\Request</code> encapsule la requête PSR-7 courante.</p>

        <h2>Méthode & URI</h2>
        <pre><code>$request->getMethod();   // 'GET', 'POST', 'PUT'…
$request->isGet();
$request->isPost();
$request->getUri();      // URL complète
$request->getPath();     // '/articles'</code></pre>

        <h2>Paramètres GET</h2>
        <pre><code>$request->getQuery('page');       // valeur ou null
$request->getQuery('page', 1);    // avec défaut
$request->getQuery();             // tableau complet</code></pre>

        <h2>Corps POST / JSON</h2>
        <pre><code>$request->getInput('titre');       // champ POST ou null
$request->getInput('titre', '');  // avec défaut
$request->getBody();              // tableau complet (POST ou JSON décodé)</code></pre>

        <h2>En-têtes & fichiers</h2>
        <pre><code>$request->getHeader('Authorization');
$files = $request->getFiles();    // PSR-7 UploadedFile[]</code></pre>

        <h2>Détection</h2>
        <pre><code>$request->isJson();           // Content-Type: application/json
$request->isAsyncRequest();   // X-Flex-Async: true</code></pre>

        {# ================================================================ #}
        {# RESPONSES                                                         #}
        {# ================================================================ #}
        {% elseif currentPage == 'responses' %}

        <h1>Réponses HTTP</h1>

        <h2>Factories statiques</h2>
        <pre><code>return Response::html('&lt;h1>Bonjour&lt;/h1>');
return Response::html('Erreur', 500);
return Response::json(['clé' => 'valeur']);
return Response::json(['error' => 'Non autorisé'], 401);
return Response::redirect('/accueil');
return Response::notFound();
return Response::notFound('Page introuvable');</code></pre>

        <h2>Réponse personnalisée</h2>
        <pre><code>return new Response('Corps', 200, [
    'Content-Type' => 'text/plain',
    'X-Custom'     => 'valeur',
]);</code></pre>

        <h2>Méthodes fluides</h2>
        <pre><code>return (new Response('', 201))
    ->setHeader('Location', '/articles/42')
    ->setStatus(201);</code></pre>

        {# ================================================================ #}
        {# VIEWS                                                             #}
        {# ================================================================ #}
        {% elseif currentPage == 'views' %}

        <h1>Vues & Templates Twig</h1>

        <p>FlexPHP utilise <strong>Twig 3.x</strong> comme moteur de templates. Les fichiers ont l'extension <code>.twig</code> et se trouvent dans <code>app/Views/</code>.</p>

        <h2>Rendre une vue</h2>
        <pre><code>// Dans un contrôleur
return $this->view('articles/index', [
    'articles' => $articlesList,
    'titre'    => 'Mes articles',
]);</code></pre>

        <h2>Héritage de layouts</h2>
        <pre><code>{# app/Views/articles/index.twig #}
{% verbatim %}{% extends 'layouts/main.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block content %}
    &lt;h1>Articles&lt;/h1>
    {% for article in articles %}
        &lt;p>{{ article.titre }}&lt;/p>
    {% else %}
        &lt;p>Aucun article.&lt;/p>
    {% endfor %}
{% endblock %}{% endverbatim %}</code></pre>

        <h2>Blocs dans le layout</h2>
        <pre><code>{# app/Views/layouts/main.twig #}
{% verbatim %}&lt;title>{% block title %}FlexPHP{% endblock %}&lt;/title>
&lt;main>{% block content %}{% endblock %}&lt;/main>
{% block scripts %}{% endblock %}{% endverbatim %}</code></pre>

        <h2>Include / partiels</h2>
        <pre><code>{% verbatim %}{% include 'components/alert.twig' with {type: 'success', message: 'Sauvegardé !'} %}{% endverbatim %}</code></pre>

        <h2>Échapper les données</h2>
        <p>Twig échappe automatiquement toutes les variables. Pour afficher du HTML brut :</p>
        <pre><code>{% verbatim %}{{ variable }}          {# échappé automatiquement #}
{{ variable|raw }}     {# HTML brut — à utiliser avec précaution #}
{{ variable|e }}       {# explicitement échappé #}{% endverbatim %}</code></pre>

        <h2>Fonctions globales FlexPHP</h2>
        <table>
            <tr><th>Fonction Twig</th><th>Description</th></tr>
            <tr><td><code>{% verbatim %}{{ csrf_token() }}{% endverbatim %}</code></td><td>Token CSRF en string</td></tr>
            <tr><td><code>{% verbatim %}{{ csrf_field()|raw }}{% endverbatim %}</code></td><td>Input hidden avec le token CSRF</td></tr>
            <tr><td><code>{% verbatim %}{{ url('route.name', {id: 42}) }}{% endverbatim %}</code></td><td>Générer une URL nommée</td></tr>
            <tr><td><code>{% verbatim %}{{ asset('css/app.css') }}{% endverbatim %}</code></td><td>Chemin vers un asset public</td></tr>
        </table>

        <h2>Formulaire avec CSRF</h2>
        <pre><code>{% verbatim %}&lt;form method="POST" action="/articles">
    {{ csrf_field()|raw }}
    &lt;input type="text" name="titre">
    &lt;button type="submit">Créer&lt;/button>
&lt;/form>{% endverbatim %}</code></pre>

        <h2>Filtres Twig utiles</h2>
        <pre><code>{% verbatim %}{{ titre|upper }}
{{ date|date('d/m/Y') }}
{{ texte|truncate(100) }}
{{ tableau|join(', ') }}
{{ prix|number_format(2, ',', ' ') }}{% endverbatim %}</code></pre>

        <h2>Ajouter une extension Twig</h2>
        <pre><code>// Dans un Service Provider (boot())
$engine = $this->app->make(\FlexPHP\View\ViewEngine::class);
$engine->getTwig()->addExtension(new MonExtension());</code></pre>

        {# ================================================================ #}
        {# DATABASE                                                          #}
        {# ================================================================ #}
        {% elseif currentPage == 'database' %}

        <h1>Base de données</h1>

        <h2>Configuration (.env)</h2>
        <pre><code>DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ma_base
DB_USERNAME=root
DB_PASSWORD=secret</code></pre>
        <p>Drivers supportés : <code>mysql</code>, <code>pgsql</code>, <code>sqlite</code>.</p>

        <h2>Accéder au DBAL</h2>
        <pre><code>use FlexPHP\Database\DatabaseManager;

$db = $this->app->make(DatabaseManager::class);
$dbal = $db->getDatabase(); // Cycle\Database\DatabaseInterface</code></pre>

        <h2>Requêtes directes</h2>
        <pre><code>$rows = $dbal->query('SELECT * FROM articles WHERE publie = ?', [true])->fetchAll();

$dbal->execute('INSERT INTO articles (titre) VALUES (?)', ['Mon titre']);

$dbal->transaction(function () use ($dbal) {
    $dbal->execute('UPDATE comptes SET solde = solde - 100 WHERE id = 1');
    $dbal->execute('UPDATE comptes SET solde = solde + 100 WHERE id = 2');
});</code></pre>

        {# ================================================================ #}
        {# ORM                                                               #}
        {# ================================================================ #}
        {% elseif currentPage == 'orm' %}

        <h1>ORM & Entités</h1>
        <p>FlexPHP utilise <strong>Cycle ORM 2.x</strong> avec des annotations PHP 8.</p>

        <h2>Générer une entité</h2>
        <pre><code>php flex make:model Article</code></pre>

        <h2>Structure d'une entité</h2>
        <pre><code>&lt;?php
namespace App\Models;
use Cycle\Annotated\Annotation\Entity;
use Cycle\Annotated\Annotation\Column;

#[Entity(table: 'articles')]
class Article
{
    #[Column(type: 'primary')]
    public int $id;

    #[Column(type: 'string', length: 255)]
    public string $titre;

    #[Column(type: 'text')]
    public string $contenu;

    #[Column(type: 'boolean', default: false)]
    public bool $publie = false;

    #[Column(type: 'datetime')]
    public \DateTimeImmutable $createdAt;
}</code></pre>

        <h2>Repository CRUD</h2>
        <pre><code>&lt;?php
namespace App\Repositories;
use App\Models\Article;
use FlexPHP\Database\BaseRepository;

class ArticleRepository extends BaseRepository
{
    protected string $entityClass = Article::class;
}

// Utilisation
$article  = $repo->findById(1);
$all      = $repo->findAll();
$filtres  = $repo->findBy(['publie' => true]);
$page     = $repo->paginate(2, 15);

$a = new Article();
$a->titre = 'Titre'; $a->contenu = '...';
$a->createdAt = new \DateTimeImmutable();
$repo->save($a);
$repo->delete($a);</code></pre>

        {# ================================================================ #}
        {# MIGRATIONS                                                        #}
        {# ================================================================ #}
        {% elseif currentPage == 'migrations' %}

        <h1>Migrations</h1>

        <h2>Commandes</h2>
        <pre><code>php flex make:migration create_articles_table
php flex migrate
php flex migrate --rollback
php flex migrate --fresh</code></pre>

        <h2>Structure d'une migration</h2>
        <pre><code>&lt;?php
use Cycle\Database\DatabaseInterface;

return new class {
    public function up(DatabaseInterface $db): void
    {
        $schema = $db->table('articles')->getSchema();
        $schema->primary('id');
        $schema->string('titre', 255);
        $schema->text('contenu');
        $schema->boolean('publie')->defaultValue(false);
        $schema->datetime('created_at');
        $schema->save();
    }

    public function down(DatabaseInterface $db): void
    {
        $db->table('articles')->getSchema()->declareDropped()->save();
    }
};</code></pre>

        <h2>Méthodes de schéma</h2>
        <table>
            <tr><th>Méthode</th><th>Description</th></tr>

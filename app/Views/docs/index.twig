        <h1>Système Async</h1>
        <p>Mises à jour d'interface sans rechargement ni JavaScript personnalisé.</p>

        <h2>Comment ça marche</h2>
        <ol>
            <li><code>flex.js</code> intercepte les clics/soumissions sur les éléments <code>flex-async</code></li>
            <li>Envoie la requête avec l'en-tête <code>X-Flex-Async: true</code></li>
            <li>Le serveur détecte cet en-tête et retourne uniquement le fragment HTML</li>
            <li><code>flex.js</code> injecte le fragment dans le DOM</li>
        </ol>

        <h2>Côté serveur</h2>
        <pre><code>use FlexPHP\Async\AsyncResponse;

public function index(Request $request): Response
{
    $articles = $this->articles->findAll();
    return AsyncResponse::render(
        $request,
        fullView:     'articles/index',
        fragmentView: 'articles/_list',
        data: ['articles' => $articles],
    );
}</code></pre>

        <h2>Attributs HTML</h2>
        <table>
            <tr><th>Attribut</th><th>Description</th></tr>
            <tr><td><code>flex-async</code></td><td>Active le mode async</td></tr>
            <tr><td><code>flex-target="#id"</code></td><td>Cible d'injection dans le DOM</td></tr>
            <tr><td><code>flex-swap="innerHTML"</code></td><td><code>innerHTML</code>, <code>outerHTML</code>, <code>append</code>, <code>prepend</code></td></tr>
            <tr><td><code>flex-trigger="click"</code></td><td><code>click</code>, <code>submit</code>, <code>load</code>, <code>hover</code></td></tr>
            <tr><td><code>flex-method="GET"</code></td><td>Méthode HTTP</td></tr>
            <tr><td><code>flex-loading="#spinner"</code></td><td>Indicateur de chargement</td></tr>
        </table>

        <h2>Exemples</h2>
        <pre><code>&lt;!-- Lien async -->
&lt;a href="/articles" flex-async flex-target="#main" flex-trigger="click">Articles&lt;/a>

&lt;!-- Formulaire sans rechargement -->
&lt;form action="/messages" method="POST"
      flex-async flex-target="#messages" flex-swap="append" flex-loading="#spinner">
    {% verbatim %}{{ csrf_field()|raw }}{% endverbatim %}
    &lt;input type="text" name="contenu">
    &lt;button type="submit">Envoyer&lt;/button>
&lt;/form>

&lt;!-- Chargement automatique -->
&lt;div flex-async flex-target="#stats" flex-trigger="load" href="/stats">&lt;/div></code></pre>


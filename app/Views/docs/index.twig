        {% elseif currentPage == 'routing-attrs' %}

        <h1>Annotations de routes</h1>

        <p>
            FlexPHP permet de déclarer les routes directement sur les méthodes des contrôleurs
            via des <strong>attributs PHP 8</strong>. Le <code>RouteScanner</code> découvre
            automatiquement toutes les routes annotées dans <code>app/Controllers/</code>.
        </p>

        <div class="callout callout-tip">
            Les routes déclarées dans <code>routes/web.php</code> sont toujours chargées en premier.
            Les annotations sont scannées ensuite — les deux approches coexistent librement.
        </div>

        <h2>Attributs disponibles</h2>
        <table>
            <tr><th>Attribut</th><th>Méthode HTTP</th><th>Cible</th></tr>
            <tr><td><code>#[Get(...)]</code></td><td>GET, HEAD</td><td>Méthode</td></tr>
            <tr><td><code>#[Post(...)]</code></td><td>POST</td><td>Méthode</td></tr>
            <tr><td><code>#[Put(...)]</code></td><td>PUT</td><td>Méthode</td></tr>
            <tr><td><code>#[Patch(...)]</code></td><td>PATCH</td><td>Méthode</td></tr>
            <tr><td><code>#[Delete(...)]</code></td><td>DELETE</td><td>Méthode</td></tr>
            <tr><td><code>#[Any(...)]</code></td><td>Toutes</td><td>Méthode</td></tr>
            <tr><td><code>#[Route(...)]</code></td><td>Configurable</td><td>Méthode</td></tr>
            <tr><td><code>#[Prefix(...)]</code></td><td>—</td><td>Classe</td></tr>
            <tr><td><code>#[Middleware(...)]</code></td><td>—</td><td>Classe ou méthode</td></tr>
        </table>

        <h2>Exemple complet</h2>
        <pre><code>&lt;?php
declare(strict_types=1);
namespace App\Controllers;

use FlexPHP\Http\Request;
use FlexPHP\Http\Response;
use FlexPHP\Routing\Attributes\Delete;
use FlexPHP\Routing\Attributes\Get;
use FlexPHP\Routing\Attributes\Middleware;
use FlexPHP\Routing\Attributes\Post;
use FlexPHP\Routing\Attributes\Prefix;
use FlexPHP\Routing\Attributes\Put;

#[Prefix('/articles')]
#[Middleware(App\Middleware\AuthMiddleware::class)]
class ArticleController extends BaseController
{
    // GET /articles  (accessible sans auth car pas de #[Middleware] sur la méthode)
    #[Get('/', name: 'articles.index')]
    public function index(Request $request): Response
    {
        return $this->view('articles/index');
    }

    // GET /articles/{id:\d+}
    #[Get('/{id:\d+}', name: 'articles.show')]
    public function show(Request $request, string $id): Response
    {
        return $this->view('articles/show', ['id' => $id]);
    }

    // POST /articles
    #[Post('/', name: 'articles.store')]
    public function store(Request $request): Response
    {
        // ... créer l'article
        return $this->redirect('/articles');
    }

    // PUT /articles/{id:\d+}
    #[Put('/{id:\d+}', name: 'articles.update')]
    public function update(Request $request, string $id): Response
    {
        return $this->redirect('/articles/' . $id);
    }

    // DELETE /articles/{id:\d+}
    #[Delete('/{id:\d+}', name: 'articles.destroy')]
    public function destroy(Request $request, string $id): Response
    {
        return $this->redirect('/articles');
    }
}</code></pre>

        <h2>#[Route] — méthodes multiples sur une seule action</h2>
        <pre><code>use FlexPHP\Routing\Attributes\Route;

#[Route('/profil', methods: ['GET', 'HEAD'], name: 'profil.show')]
#[Route('/profil', methods: ['POST'],        name: 'profil.update')]
public function profil(Request $request): Response
{
    if ($request->isPost()) {
        // traitement du formulaire
    }
    return $this->view('profil');
}</code></pre>

        <h2>#[Prefix] — préfixe de classe</h2>
        <p>Appliqué à la classe, le préfixe est ajouté devant toutes les routes déclarées dans le contrôleur.</p>
        <pre><code>#[Prefix('/admin')]
class AdminController extends BaseController
{
    #[Get('/dashboard', name: 'admin.dashboard')]
    public function dashboard(Request $request): Response { ... }
    // → GET /admin/dashboard

    #[Get('/users', name: 'admin.users')]
    public function users(Request $request): Response { ... }
    // → GET /admin/users
}</code></pre>

        <h2>#[Middleware] — sur la classe ou la méthode</h2>
        <pre><code>// Sur la classe : s'applique à TOUTES les routes du contrôleur
#[Prefix('/admin')]
#[Middleware(AuthMiddleware::class, AdminMiddleware::class)]
class AdminController extends BaseController { ... }

// Sur une méthode : s'ajoute au middleware de classe
#[Get('/secret', name: 'admin.secret')]
#[Middleware(SuperAdminMiddleware::class)]
public function secret(Request $request): Response { ... }
// Middleware appliqués : AuthMiddleware, AdminMiddleware, SuperAdminMiddleware</code></pre>

        <h2>Coexistence avec routes/web.php</h2>
        <pre><code>// routes/web.php — les deux approches fonctionnent ensemble
$router->get('/page-statique', fn($r) => Response::html('&lt;h1>Page&lt;/h1>'));

// app/Controllers/ArticleController.php — route via attribut
#[Get('/articles', name: 'articles.index')]
public function index(Request $request): Response { ... }</code></pre>

        <div class="callout callout-info">
            <strong>Ordre de chargement :</strong> <code>routes/web.php</code> est chargé en premier,
            puis le scanner parcourt <code>app/Controllers/</code>. En cas de conflit de nom de route,
            la première déclaration gagne.
        </div>

        <h2>Scanner d'autres répertoires</h2>
        <p>Par défaut, seul <code>app/Controllers/</code> est scanné. Pour ajouter des répertoires, configurez <code>config/app.php</code> :</p>
        <pre><code>// config/app.php
'route_scan_paths' => [
    ['dir' => __DIR__ . '/../app/Controllers',  'namespace' => 'App\\Controllers'],
    ['dir' => __DIR__ . '/../modules/Blog',     'namespace' => 'Modules\\Blog'],
],</code></pre>

